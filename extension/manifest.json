{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "Claude in Zen",
  "version": "0.11.0",
  "description": "Personal-use agent bridge that lets a Claude session read and act on pages in Zen. Not affiliated with or endorsed by Anthropic or Zen.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-in-zen@f.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "menus",
    "activeTab",
    "nativeMessaging",
    "downloads",
    "clipboardWrite",
    "webRequest",
    "alarms",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/i18n.js",
      "lib/policy.js",
      "lib/state.js",
      "lib/files.js",
      "lib/markdown.js",
      "lib/docx.js",
      "lib/netlog.js",
      "lib/army.js",
      "lib/local.js",
      "lib/pageOp.js",
      "lib/pageOpRead.js",
      "lib/pageOpAct.js",
      "lib/siteGate.js",
      "lib/pageTools.js",
      "lib/bg-panel.js",
      "lib/bg-menus.js",
      "lib/bg-accounts.js",
      "lib/bg-permissions.js",
      "lib/bg-chat.js",
      "lib/bg-macros.js",
      "lib/bg-router.js",
      "background.js"
    ],
    "persistent": true
  },
  "sidebar_action": {
    "default_title": "Claude in Zen",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "64": "icons/icon.svg"
    },
    "open_at_install": true
  },
  "browser_action": {
    "default_title": "Claude in Zen",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "64": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle the Claude in Zen panel"
    },
    "stop-claude": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop Claude"
    }
  }
}
